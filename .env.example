# Copy to .env for local development. Never put real credentials in this template.
DATABASE_URL=jdbc:postgresql://localhost:5432/mandatelens
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

SPRING_PROFILES_ACTIVE=storesync-simulator,agentguard-deterministic
AGENTGUARD_DEMO_MAX_AMOUNT=600.00

# PayPal Developer Dashboard > Apps & Credentials > Sandbox
PAYPAL_SANDBOX_ENABLED=false
PAYPAL_ORDERS_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_ORDERS_CLIENT_ID=
PAYPAL_ORDERS_CLIENT_SECRET=
PAYPAL_ORDERS_RETURN_URL=http://localhost:5173/checkout/return
PAYPAL_ORDERS_CANCEL_URL=http://localhost:5173/checkout/cancel
